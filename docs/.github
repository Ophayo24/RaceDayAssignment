workflows

part1-ci.yml

RaceDay Part 1 CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  validate-part1:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check required folders and files
        run: |
          test -d docs
          test -f docs/RaceDay_ERD.png
          test -f docs/API_Endpoint_Plan.md
          test -f docs/RaceDayDB.sql
          test -f README.md

      - name: Validate SQL file exists and is not empty
        run: |
          test -s docs/RaceDayDB.sql

      - name: Part 1 validation successful
        run: echo "RaceDay Part 1 files are present and valid."
